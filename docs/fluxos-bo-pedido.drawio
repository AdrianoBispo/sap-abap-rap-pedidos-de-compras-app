ens&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#556B82"&gt;rascunho mantido&lt;/font&gt;' style="rounded=1;arcSize=60;absoluteArcSize=1;strokeColor=#D20A0A;fillColor=#FFEAF4;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1D2D3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="1080" width="200" height="60" as="geometry"/></mxCell><mxCell id="j" value='&lt;b&gt;Activate: ReservarEstoqueRegistro&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#556B82"&gt;EML ReservarEstoque no BO Item&lt;/font&gt;' style="rounded=1;arcSize=16;absoluteArcSize=1;strokeColor=#5D36FF;fillColor=#F1ECFF;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1D2D3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="200" height="60" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Reserva OK?&lt;/b&gt;" style="rhombus;strokeColor=#C35500;fillColor=#FFF8D6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1D2D3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="1310" width="220" height="80" as="geometry"/></mxCell><mxCell id="k2" value='&lt;b&gt;Compensação e Save reprovado&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#556B82"&gt;libera o reservado; ValidarRegistro falha&lt;/font&gt;' style="rounded=1;arcSize=60;absoluteArcSize=1;strokeColor=#D20A0A;fillColor=#FFEAF4;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1D2D3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="1320" width="200" height="60" as="geometry"/></mxCell><mxCell id="l" value='&lt;b&gt;Pedido ABERTO&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#556B82"&gt;preços fixados, total calculado&lt;/font&gt;' style="rounded=1;arcSize=60;absoluteArcSize=1;strokeColor=#188918;fillColor=#F5FAE5;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1D2D3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="200" height="