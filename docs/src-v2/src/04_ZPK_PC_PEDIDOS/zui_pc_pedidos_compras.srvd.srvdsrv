@EndUserText.label: 'Pedidos de Compras'
define service ZUI_PC_PEDIDOS_COMPRAS {
  /* Objeto transacional */
  expose ZC_PC_PEDIDO_APP          as Pedido;
  expose ZC_PC_ITEM_PEDIDO_APP     as ItemPedido;
  expose ZC_PC_PAGAMENTO_APP       as Pagamento;
  expose ZC_PC_PED_CLI_SNAP_APP    as ClienteSnapshot;
  expose ZC_PC_PED_ITEM_SNAP_APP   as ItemSnapshot;

  /* Comunicação com Clientes e Estoque (somente leitura) */
  expose ZC_PC_CLIENTE_VALUEHELP   as ClienteVH;
  expose ZC_PC_ENDERECO_VALUEHELP  as EnderecoVH;
  expose ZC_PC_ITEM_VALUEHELP      as ItemVH;

  /* CodeLists */
  expose ZC_PC_STATUSPED_VALUEHELP as StatusPedidoVH;
  expose ZC_PC_STATUSPAG_VALUEHELP as StatusPagamentoVH;
  expose ZC_PC_METODOPAG_VALUEHELP as MetodoPagamentoVH;
}
