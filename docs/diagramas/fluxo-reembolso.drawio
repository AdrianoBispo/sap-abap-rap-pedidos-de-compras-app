vo)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#0070F2;fillColor=#EBF8FF;fontSize=11;fontStyle=1;fontFamily=Helvetica;fontColor=#1D2D3E;" vertex="1" parent="1"><mxGeometry x="212" y="117" width="170" height="56" as="geometry"/></mxCell><mxCell id="v24" value="CancelarPedido detecta StatusPagamento = APROVADO" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#0070F2;fillColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;fontColor=#1D2D3E;" vertex="1" parent="1"><mxGeometry x="452" y="260" width="160" height="70" as="geometry"/></mxCell><mxCell id="v25" value="iniciar_processo_reembolso (EML)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#0070F2;fillColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;fontColor=#1D2D3E;" vertex="1" parent="1"><mxGeometry x="687" y="260" width="160" height="70" as="geometry"/></mxCell><mxCell id="v26" value="Criar solicitação PENDENTE e guardar StatusPedidoAnterior" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#0070F2;fillColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;fontColor=#1D2D3E;" vertex="1" parent="1"><mxGeometry x="687" y="410" width="160" height="70" as="geometry"/></mxCell><mxCell id="v27" value="PROCESSANDO_REEMBOLSO&lt;br&gt;(reserva mantida)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#0070F2;fillColor=#EBF8FF;fontSize=11;fontStyle=1;fontFamily=Helvetica;fontColor=#1D2D3E;" vertex="1" parent="1"><mxGeometry x="912" y="265" width="180" height="60" as="geometry"/></mxCell><mxCell id="v28" value="Abrir a solicitação (ações só com status PENDENTE)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#0070F2;fillColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;fontColor=#1D2D3E;" vertex="1" parent="1"><mxGeometry x="1157" y="560" width="160" height="70" as="geometry"/></mxCell><mxCell id="v29" value="Aprovar ou rejeitar?" style="rhombus;html=1;whit