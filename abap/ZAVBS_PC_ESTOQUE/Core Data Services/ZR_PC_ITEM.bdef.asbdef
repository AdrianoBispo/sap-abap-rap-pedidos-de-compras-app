managed implementation in class zbp_r_pc_item unique;
strict ( 2 );
with draft;

/* ---------------------------------------------------------------------
   BO Item de Estoque
   - Draft habilitado para manutenção do item (somente administrador)
   - SKU gerado no backend (intervalo de numeração ZPC_NR / 02)
   - QtdeDisponivel e StatusEstoque calculados no backend e persistidos
     (permitem filtro/ordenação na lista)
   - Reserva, liberação e baixa: actions internas ao domínio, NÃO expostas
     na projection; executadas somente pelo BO Pedido via EML, na mesma
     LUW e sob o lock do item (controle de concorrência)
   --------------------------------------------------------------------- */
define behavior for ZR_PC_ITEM alias Item
persistent table zta_pc_item
draft table zta_pc_item_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete ( features : instance, precheck );

  field ( numbering : managed, readonly ) ItemUUID;
  field ( readonly ) Sku, QtdeReservada, QtdeDisponivel, StatusEstoque,
                     CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) Nome, Categoria, QtdeEstoque, PrecoUnitario, Currency;

  action ( authorization : none ) ReservarEstoque parameter ZPC_A_QTDE_INPUT result [1] $self;
  action ( authorization : none ) LiberarReserva  parameter ZPC_A_QTDE_INPUT result [1] $self;
  action ( authorization : none ) BaixarEstoque   parameter ZPC_A_QTDE_INPUT result [1] $self;

  /* Importação em massa por planilha (.xlsx ou .csv): cria itens ativos com
     SKU gerado na hora. Tudo ou nada (ver ImportarPlanilha). */
  static action ImportarPlanilha deep parameter ZPC_A_UPLOAD_INPUT;

  determination DefinirValoresIniciais on modify { create; }
  determination RecalcularStatusEstoque on modify { create; field QtdeEstoque; }
  /* O SKU usa as 3 primeiras letras da Categoria; por isso só pode ser gerado
     no Save (Prepare), quando a categoria já foi escolhida. Gerado na criação
     do rascunho (on modify) a categoria ainda está vazia e o SKU saía SKU-XXX-.
     Fica no Prepare (fase de interação) porque o GET NUMBER de ZPC_NR não pode
     rodar na fase de gravação; na gravação o SKU já existe e nada é gerado. */
  determination GerarSku on save { create; field Categoria; }

  validation ValidarItem on save { create; field Nome, Categoria, PrecoUnitario, Currency; }
  validation ValidarQuantidades on save { create; field QtdeEstoque; }
  validation ValidarInativacaoItem on save { field ItemAtivo; }
  validation ValidarSkuUnico on save { create; field Sku; }
  validation ValidarFoto on save { create; field FotoItem, FotoMimeType, FotoFileName; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    determination GerarSku;
    validation ValidarItem;
    validation ValidarQuantidades;
    validation ValidarInativacaoItem;
    validation ValidarFoto;
  }

  side effects
  {
    field QtdeEstoque affects field QtdeDisponivel, field StatusEstoque;
  }

  mapping for zta_pc_item
  {
    ItemUUID           = item_uuid;
    FotoItem           = foto_item;
    FotoMimeType       = foto_mime_type;
    FotoFileName       = foto_file_name;
    Sku                = sku;
    Nome               = nome;
    Descricao          = descricao;
    Categoria          = categoria;
    QtdeEstoque        = qtde_estoque;
    QtdeReservada      = qtde_reservada;
    QtdeDisponivel     = qtde_disponivel;
    StatusEstoque      = status_estoque;
    Currency           = currency;
    PrecoUnitario      = preco_unitario;
    ItemAtivo          = item_ativo;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}