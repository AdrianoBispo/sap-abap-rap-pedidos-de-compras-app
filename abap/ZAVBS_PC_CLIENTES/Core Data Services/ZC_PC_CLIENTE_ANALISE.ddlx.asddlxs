@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName:       'Cliente',
                typeNamePlural: 'Clientes' },
  chart: [{ qualifier:           'ClientesPorGenero',
            title:               'Clientes por gênero',
            chartType:           #DONUT,
            dimensions:          [ 'Genero' ],
            measures:            [ 'QtdeClientes' ],
            dimensionAttributes: [{ dimension: 'Genero', role: #CATEGORY }],
            measureAttributes:   [{ measure: 'QtdeClientes', role: #AXIS_1 }] },
          { qualifier:           'ScoreMedioPorUf',
            title:               'Score médio por UF',
            chartType:           #COLUMN,
            dimensions:          [ 'Uf' ],
            measures:            [ 'ScoreMedio' ],
            dimensionAttributes: [{ dimension: 'Uf', role: #CATEGORY }],
            measureAttributes:   [{ measure: 'ScoreMedio', role: #AXIS_1 }] },
          { qualifier:           'CadastrosPorMes',
            title:               'Cadastros de clientes por mês',
            chartType:           #COLUMN,
            dimensions:          [ 'MesCadastro' ],
            measures:            [ 'QtdeClientes' ],
            dimensionAttributes: [{ dimension: 'MesCadastro', role: #CATEGORY }],
            measureAttributes:   [{ measure: 'QtdeClientes', role: #AXIS_1 }] },
          { qualifier:           'ClientesPorFaixaScore',
            title:               'Clientes por faixa de score',
            chartType:           #DONUT,
            dimensions:          [ 'FaixaScore' ],
            measures:            [ 'QtdeClientes' ],
            dimensionAttributes: [{ dimension: 'FaixaScore', role: #CATEGORY }],
            measureAttributes:   [{ measure: 'QtdeClientes', role: #AXIS_1 }] },
          { qualifier:           'ClientesPorUf',
            title:               'Clientes por UF',
            chartType:           #COLUMN,
            dimensions:          [ 'Uf' ],
            measures:            [ 'QtdeClientes' ],
            dimensionAttributes: [{ dimension: 'Uf', role: #CATEGORY }],
            measureAttributes:   [{ measure: 'QtdeClientes', role: #AXIS_1 }] }],
  presentationVariant: [{ sortOrder: [{ by: 'QtdeClientes', direction: #DESC }],
                          visualizations: [{ type: #AS_CHART, qualifier: 'ClientesPorGenero' }] },
                         { qualifier: 'ScoreMedioPorUf', sortOrder: [{ by: 'ScoreMedio', direction: #DESC }],
                          visualizations: [{ type: #AS_CHART, qualifier: 'ScoreMedioPorUf' }] },
                         { qualifier: 'CadastrosPorMes', sortOrder: [{ by: 'MesCadastro', direction: #ASC }],
                          visualizations: [{ type: #AS_CHART, qualifier: 'CadastrosPorMes' }] },
                         { qualifier: 'ClientesPorFaixaScore', sortOrder: [{ by: 'QtdeClientes', direction: #DESC }],
                          visualizations: [{ type: #AS_CHART, qualifier: 'ClientesPorFaixaScore' }] },
                         { qualifier: 'ClientesPorUf', sortOrder: [{ by: 'QtdeClientes', direction: #DESC }],
                          visualizations: [{ type: #AS_CHART, qualifier: 'ClientesPorUf' }] }]
}
annotate entity ZC_PC_CLIENTE_ANALISE with
{
  @UI.hidden: true
  ClienteUUID;

  @UI: { lineItem:       [{ position: 10, label: 'Cliente', importance: #HIGH }],
         selectionField: [{ position: 50 }] }
  @EndUserText.label: 'Cliente'
  Nome;

  @UI: { lineItem:       [{ position: 20, label: 'Gênero' }],
         selectionField: [{ position: 10 }] }
  @UI.textArrangement: #TEXT_ONLY
  @EndUserText.label: 'Gênero'
  Genero;

  @UI.hidden: true
  GeneroTexto;

  @UI: { lineItem:       [{ position: 30, label: 'Ativo' }],
         selectionField: [{ position: 20 }] }
  @EndUserText.label: 'Cliente ativo'
  ClienteAtivo;

  @UI: { lineItem:       [{ position: 40, label: 'UF' }],
         selectionField: [{ position: 30 }] }
  @EndUserText.label: 'UF do endereço principal'
  Uf;

  @UI: { lineItem:       [{ position: 50, label: 'Faixa do score' }],
         selectionField: [{ position: 40 }] }
  @EndUserText.label: 'Faixa do score'
  FaixaScore;

  @UI: { lineItem:       [{ position: 60, label: 'Mês de cadastro' }] }
  @EndUserText.label: 'Mês de cadastro'
  MesCadastro;

  @UI: { lineItem:  [{ position: 70, label: 'Clientes' }],
         dataPoint: { title: 'Quantidade de clientes' } }
  @EndUserText.label: 'Quantidade de clientes'
  QtdeClientes;

  @UI: { lineItem:  [{ position: 80, label: 'Score médio', importance: #HIGH }],
         dataPoint: { title: 'Score médio dos clientes' } }
  @EndUserText.label: 'Score médio'
  ScoreMedio;
}
