projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_PC_PEDIDO_APP alias Pedido
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action SimularPagamento;
  use action AprovarPedido;
  use action CancelarPedido;
  use action ImportarPlanilha;

  use association _Itens           { create; with draft; }
  use association _Pagamento       { with draft; }
  use association _ClienteSnapshot { with draft; }
  use association _ItensSnapshot   { with draft; }
}

define behavior for ZC_PC_ITEM_PEDIDO_APP alias ItemPedido
use etag
{
  use update;
  use delete;

  use association _Pedido { with draft; }
}

define behavior for ZC_PC_PAGAMENTO_APP alias Pagamento
use etag
{
  use association _Pedido { with draft; }
}

define behavior for ZC_PC_PED_CLI_SNAP_APP alias ClienteSnapshot
use etag
{
  use association _Pedido { with draft; }
}

define behavior for ZC_PC_PED_ITEM_SNAP_APP alias ItemSnapshot
use etag
{
  use association _Pedido { with draft; }
}