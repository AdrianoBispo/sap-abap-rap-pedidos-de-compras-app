  @EndUserText.label: 'Total'
  ValorTotal;

  @UI.hidden: true
  CreatedBy;

  @UI: { identification: [{ position: 120, label: 'Gerado em' }] }
  @EndUserText.label: 'Gerado em'
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
