@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName:       'Snapshot do item',
                typeNamePlural: 'Snapshots dos itens',
                title:          { type: #STANDARD, value: 'Nome' },
                description:    { type: #STANDARD, value: 'Sku' } }
}
annotate entity ZC_PC_PED_ITEM_SNAP_APP with
{
  @UI.facet: [
    { id: 'Historico', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'Item', position: 10 }
  ]

  @UI.hidden: true
  SnapshotItemUUID;

  @UI.hidden: true
  PedidoUUID;

  @UI.hidden: true
  ItemPedidoUUID;

  @UI.hidden: true
  ItemUUID;

  @UI: { lineItem: [{ position: 20, label: 'SKU' }],
         identification: [{ position: 20, label: 'SKU' }] }
  @EndUserText.label: 'SKU'
  Sku;

  @UI: { lineItem: [{ position: 10, label: 'Item', importance: #HIGH }],
         identification: [{ position: 10, label: 'Item' }] }
  @EndUserText.label: 'Item'
  Nome;

  @UI.hidden: true
  Descricao;

  @UI.hidden: true
  Categoria;

  @UI: { lineItem: [{ position: 40, label: 'Quantidade', importance: #HIGH }],
         identification: [{ position: 40, label: 'Quantidade' }] }
  @EndUserText.label: 'Quantidade'
  Quantidade;

  @UI.hidden: true
  Currency;

  @UI: { lineItem: [{ position: 50, label: 'Preço unitário' }],
         identification: [{ position: 50, label: 'Preço unitário' }] }
  @EndUserText.label: 'Preço unitário'
  PrecoUnitario;

  @UI: { lineItem: [{ position: 60, label: 'Total', importance: #HIGH }],
         identification: [{ position: 60, label: 'Total do item' }] }
  @EndUserText.label: 'Total do item'
  ValorTotal;

  @UI.hidden: true
  CreatedBy;

  @UI.hidden: true
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}