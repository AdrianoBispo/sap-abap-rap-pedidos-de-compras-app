projection;
strict ( 2 );
use draft;
use side effects;

/* ---------------------------------------------------------------------
   Projeção do BO ZR_PC_CLIENTE para o app Gestão de Clientes
   - Cliente (root) e Endereço (child) expostos com draft
   - Regras (determinations, validations, autorização) ficam no BO base
   - Endereço só é criado pela composição a partir do Cliente
   - ImportarPlanilha: importação em massa por planilha (.xlsx ou .csv)
   --------------------------------------------------------------------- */
define behavior for ZC_PC_CLIENTE_APP alias Cliente
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action ImportarPlanilha;

  use association _Endereco { create; with draft; }
}

define behavior for ZC_PC_ENDERECO_APP alias Endereco
use etag
{
  use update;
  use delete;

  use action DefinirEnderecoPrincipal;

  use association _Cliente { with draft; }
}