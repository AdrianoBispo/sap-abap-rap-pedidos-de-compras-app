{
  "name": "zpc-pedidos-compras-ui5",
  "version": "1.0.0",
  "private": true,
  "description": "Front-end Fiori Elements (OData V4) do projeto Pedidos de Compras - SAP RAP / ABAP Cloud",
  "workspaces": [
    "clientes",
    "estoque",
    "pedidos"
  ],
  "scripts": {
    "set-backend": "node scripts/set-backend.mjs",
    "start:clientes": "npm start -w clientes",
    "start:estoque": "npm start -w estoque",
    "start:pedidos": "npm start -w pedidos",
    "start:launchpad": "npm run start-launchpad -w pedidos",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "deploy": "npm run deploy --workspaces",
    "deploy:clientes": "npm run deploy -w clientes",
    "deploy:estoque": "npm run deploy -w estoque",
    "deploy:pedidos": "npm run deploy -w pedidos"
  },
  "engines": {
    "node": ">=20"
  }
}
