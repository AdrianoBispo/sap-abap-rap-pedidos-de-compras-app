# Configuração do sistema SAP usada pelas apps Fiori de ui5/ (proxy do `npm start` e `npm run deploy`).
#
# 1. Copie este arquivo para ui5/.env (o .env não vai para o Git).
# 2. Preencha os valores do seu sistema.
# 3. Opcional: um <app>/.env sobrepõe estes valores só para aquela app; variáveis já
#    definidas no ambiente (CI/CD, terminal) sobrepõem os dois arquivos.
#
# Os arquivos ui5*.yaml usam placeholders ${VARIAVEL}; o script ui5/scripts/sap-env.mjs
# preenche os valores e executa o comando (ver ui5/README.md).

# URL do sistema ABAP, sem barra no final.
#   SAP BTP, ABAP environment: https://<id-do-sistema>.abap.<regiao>.hana.ondemand.com
#   SAP On-Premise:            https://<host>:<porta-https>
SAP_URL=https://<id-do-sistema>.abap.<regiao>.hana.ondemand.com

# Mandante (sap-client).
SAP_CLIENT=100

# Tipo de autenticação do proxy e do deploy.
#   BTP ABAP environment: reentranceTicket (login pelo navegador)
#   On-Premise:           basic (usuário e senha em FIORI_TOOLS_USER / FIORI_TOOLS_PASSWORD)
SAP_AUTH_TYPE=reentranceTicket

# Credenciais para autenticação basic (somente On-Premise ou CI/CD). Deixe comentado no BTP.
# FIORI_TOOLS_USER=
# FIORI_TOOLS_PASSWORD=

# Pacotes ABAP em que o deploy cria as aplicações BSP (o prefixo ZAVBS é opcional; sugestão: ZPK).
SAP_PACKAGE_CLIENTES=ZAVBS_PC_CLIENTES
SAP_PACKAGE_ESTOQUE=ZAVBS_PC_ESTOQUE
SAP_PACKAGE_PEDIDOS=ZAVBS_PC_PEDIDOS
SAP_PACKAGE_REEMBOLSOS=ZAVBS_PC_REEMBOLSOS

# Ordem de transporte do deploy. Vazio no BTP (software component ZLOCAL não usa transporte);
# no On-Premise, informe a ordem Workbench (ex.: S4DK900123).
SAP_TRANSPORT=
