<?xml version="1.0" encoding="utf-8"?>
<!--
  Anotações locais da app Pedidos de Compras.
  Só contém o que não está nas anotações CDS do backend:

  Navegação entre apps. As projeções ABAP marcam ClienteUUID/NomeCliente com o
  semantic object ZPCCliente (@Consumption.semanticObject). A app Gestão de Clientes
  abre direto a Object Page quando recebe a chave semântica do Cliente (Cpf). No
  pedido esse campo se chama CpfCliente, então é renomeado para Cpf aqui.
  O item do pedido já expõe "Sku", mesmo nome da chave semântica do Item, e não
  precisa de mapeamento.
-->
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="/sap/opu/odata4/sap/zui_pc_pedidos_compras_o4/srvd/sap/zui_pc_pedidos_compras/0001/$metadata">
        <edmx:Include Namespace="com.sap.gateway.srvd.zui_pc_pedidos_compras.v0001" Alias="SAP__self"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="zpc.pedidos.annotations">
            <Annotations Target="SAP__self.PedidoType/NomeCliente">
                <Annotation Term="Common.SemanticObjectMapping">
                    <Collection>
                        <Record Type="Common.SemanticObjectMappingType">
                            <PropertyValue Property="LocalProperty" PropertyPath="CpfCliente"/>
                            <PropertyValue Property="SemanticObjectProperty" String="Cpf"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>
            <Annotations Target="SAP__self.PedidoType/ClienteUUID">
                <Annotation Term="Common.SemanticObjectMapping">
                    <Collection>
                        <Record Type="Common.SemanticObjectMappingType">
                            <PropertyValue Property="LocalProperty" PropertyPath="CpfCliente"/>
                            <PropertyValue Property="SemanticObjectProperty" String="Cpf"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
