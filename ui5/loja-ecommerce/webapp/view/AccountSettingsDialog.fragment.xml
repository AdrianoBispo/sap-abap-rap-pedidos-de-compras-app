<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form"
	xmlns:unified="sap.ui.unified">
	<Dialog
		id="settingsDialog"
		title="{i18n>settingsTitle}"
		icon="sap-icon://action-settings"
		contentWidth="40rem"
		contentHeight="32rem"
		busy="{profile>/busy}"
		escapeHandler=".onSettingsClose">
		<content>
			<MessageStrip
				class="sapUiSmallMargin"
				type="Error"
				showIcon="true"
				visible="{= !!${profile>/error} }"
				text="{profile>/error}"/>
			<IconTabBar
				id="settingsTabs"
				class="sapUiResponsiveContentPadding"
				expandable="false"
				stretchContentHeight="false">
				<items>
					<IconTabFilter
						key="data"
						icon="sap-icon://person-placeholder"
						text="{i18n>settingsData}">
						<HBox
							class="sapUiSmallMargin"
							alignItems="Center">
							<Avatar
								class="sapUiSmallMarginEnd"
								displaySize="XL"
								src="{account>/photoUrl}"
								initials="{path: 'session>/customer/Nome', formatter: '.initials'}"
								fallbackIcon="sap-icon://person-placeholder"/>
							<VBox>
								<unified:FileUploader
									id="photoUploader"
									buttonOnly="true"
									buttonText="{i18n>settingsPhotoChange}"
									icon="sap-icon://camera"
									fileType="jpg,jpeg,png,webp"
									mimeType="image/jpeg,image/png,image/webp"
									maximumFileSize="10"
									multiple="false"
									change=".onPhotoChange"
									typeMissmatch=".onPhotoInvalid"
									fileSizeExceed=".onPhotoInvalid"/>
								<Text
									class="sapUiTinyMarginTop"
									text="{i18n>settingsPhotoHint}"/>
							</VBox>
						</HBox>
						<form:SimpleForm
							editable="false"
							layout="ResponsiveGridLayout"
							labelSpanXL="4"
							labelSpanL="4"
							labelSpanM="4"
							labelSpanS="12"
							title="{i18n>settingsPersonalData}">
							<Label text="{i18n>checkoutCustomerName}"/>
							<Text text="{profile>/customer/Nome}"/>
							<Label text="{i18n>checkoutCustomerCpf}"/>
							<Text text="{path: 'profile>/customer/Cpf', formatter: '.formatCpf'}"/>
							<Label text="{i18n>checkoutCustomerEmail}"/>
							<Text text="{profile>/customer/Email}"/>
							<Label text="{i18n>checkoutCustomerPhone}"/>
							<Text text="{path: 'profile>/customer/Telefone', formatter: '.formatPhone'}"/>
							<Label text="{i18n>checkoutCustomerBirth}"/>
							<Text text="{path: 'profile>/customer/DataNascimento', formatter: '.formatDate'}"/>
							<Label text="{i18n>settingsGender}"/>
							<Text text="{profile>/customer/GeneroTexto}"/>
							<Label text="{i18n>settingsSince}"/>
							<Text text="{path: 'profile>/customer/CreatedAt', formatter: '.formatDate'}"/>
							<Label text="{i18n>settingsScore}"/>
							<Text text="{profile>/customer/ScoreCliente}"/>
						</form:SimpleForm>
						<List
							headerText="{i18n>settingsAddresses}"
							noDataText="{i18n>settingsNoAddress}"
							items="{profile>/addresses}">
							<items>
								<CustomListItem>
									<VBox class="sapUiSmallMargin">
										<HBox justifyContent="SpaceBetween">
											<Title
												level="H5"
												titleStyle="H6"
												text="{profile>Logradouro}, {profile>Numero}"/>
											<ObjectStatus
												text="{i18n>settingsMainAddress}"
												state="Success"
												visible="{profile>EnderecoPrincipal}"/>
										</HBox>
										<Text
											visible="{= !!${profile>Complemento} }"
											text="{profile>Complemento}"/>
										<Text text="{profile>Bairro} - {profile>Cidade}/{profile>Uf}"/>
										<Text text="{i18n>checkoutInvoiceAddressZip}: {path: 'profile>Cep', formatter: '.formatCep'}"/>
									</VBox>
								</CustomListItem>
							</items>
						</List>
					</IconTabFilter>
					<IconTabFilter
						key="account"
						icon="sap-icon://decline"
						iconColor="Negative"
						text="{i18n>settingsAccount}">
						<VBox class="sapUiSmallMargin">
							<Title
								level="H4"
								text="{i18n>settingsDeactivateTitle}"/>
							<MessageStrip
								class="sapUiSmallMarginTopBottom"
								type="Warning"
								showIcon="true"
								text="{i18n>settingsDeactivateInfo}"/>
							<Button
								text="{i18n>settingsDeactivateButton}"
								type="Reject"
								icon="sap-icon://delete"
								press=".onDeactivate"/>
						</VBox>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<endButton>
			<Button
				text="{i18n>settingsClose}"
				press=".onSettingsClose"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
