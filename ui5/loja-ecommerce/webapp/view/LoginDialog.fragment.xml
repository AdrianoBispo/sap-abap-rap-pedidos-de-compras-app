<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<Dialog
		id="loginDialog"
		title="{i18n>loginTitle}"
		contentWidth="26rem"
		busy="{login>/busy}"
		escapeHandler=".onLoginCancel">
		<content>
			<MessageStrip
				class="sapUiSmallMargin"
				type="Error"
				showIcon="true"
				visible="{= !!${login>/error} }"
				text="{login>/error}"/>
			<form:SimpleForm
				editable="true"
				layout="ResponsiveGridLayout"
				labelSpanXL="12"
				labelSpanL="12"
				labelSpanM="12"
				labelSpanS="12">
				<Label
					text="{i18n>checkoutCustomerCpf}"
					labelFor="loginCpf"
					required="true"/>
				<Input
					id="loginCpf"
					value="{login>/cpf}"
					valueState="{login>/cpfState}"
					valueStateText="{i18n>loginCpfInvalid}"
					placeholder="{i18n>cpfText}"
					maxLength="14"
					autocomplete="username"
					liveChange=".onLoginCpfLiveChange"
					submit=".onLogin"/>
				<Label text="{i18n>loginSecondFactor}"/>
				<SegmentedButton
					selectedKey="{login>/method}"
					selectionChange=".onLoginMethodChange">
					<items>
						<SegmentedButtonItem
							key="EMAIL"
							text="{i18n>checkoutCustomerEmail}"/>
						<SegmentedButtonItem
							key="TELEFONE"
							text="{i18n>checkoutCustomerPhone}"/>
					</items>
				</SegmentedButton>
				<Label
					text="{= ${login>/method} === 'EMAIL' ? ${i18n>checkoutCustomerEmail} : ${i18n>checkoutCustomerPhone} }"
					labelFor="loginValue"
					required="true"/>
				<Input
					id="loginValue"
					value="{login>/value}"
					type="{= ${login>/method} === 'EMAIL' ? 'Email' : 'Tel' }"
					placeholder="{= ${login>/method} === 'EMAIL' ? ${i18n>emailAddressText} : ${i18n>phoneNumberText} }"
					autocomplete="off"
					liveChange=".onLoginValueLiveChange"
					submit=".onLogin"/>
			</form:SimpleForm>
			<Text
				class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
				text="{i18n>loginFirstPurchase}"/>
		</content>
		<beginButton>
			<Button
				text="{i18n>loginButton}"
				type="Emphasized"
				enabled="{login>/canLogin}"
				press=".onLogin"/>
		</beginButton>
		<endButton>
			<Button
				text="{i18n>loginCancel}"
				press=".onLoginCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
