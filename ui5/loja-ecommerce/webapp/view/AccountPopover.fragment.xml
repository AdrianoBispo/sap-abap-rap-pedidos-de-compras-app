<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ResponsivePopover
		id="accountPopover"
		title="{i18n>accountTitle}"
		placement="Bottom"
		contentWidth="18rem">
		<content>
			<VBox class="sapUiSmallMargin">
				<Avatar
					class="sapUiTinyMarginBottom"
					displaySize="L"
					src="{account>/photoUrl}"
					initials="{path: 'session>/customer/Nome', formatter: '.initials'}"
					fallbackIcon="sap-icon://person-placeholder"/>
				<Title
					level="H4"
					text="{session>/customer/Nome}"/>
				<Text
					class="sapUiTinyMarginTop"
					text="{session>/customer/Cidade}/{session>/customer/Uf}"/>
				<Text text="{i18n>checkoutCustomerCpf}: {path: 'session>/customer/Cpf', formatter: '.formatCpf'}"/>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{i18n>accountSettings}"
				icon="sap-icon://action-settings"
				press=".onSettings"/>
		</beginButton>
		<endButton>
			<Button
				text="{i18n>accountLogout}"
				icon="sap-icon://log"
				press=".onLogout"/>
		</endButton>
	</ResponsivePopover>
</core:FragmentDefinition>
