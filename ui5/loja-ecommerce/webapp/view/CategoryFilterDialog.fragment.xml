<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout">
	<ViewSettingsDialog
		id="categoryFilterDialog"
		confirm=".handleConfirm"
		cancel=".handleCancel"
		resetFilters=".handleResetFilters">
		<sortItems>
			<ViewSettingsItem text="{i18n>sortByName}" key="Name" selected="true"/>
			<ViewSettingsItem text="{i18n>sortByPrice}" key="Price"/>
		</sortItems>
		<filterItems>
			<ViewSettingsFilterItem
				text="{i18n>availabilityFilterTitle}"
				key="availabilityKey">
				<items>
					<ViewSettingsItem text="{i18n>availableFilterTitle}" key="Available"/>
					<ViewSettingsItem text="{i18n>lastUnitsFilterTitle}" key="LastUnits"/>
					<ViewSettingsItem text="{i18n>outOfStockFilterTitle}" key="OutOfStock"/>
				</items>
			</ViewSettingsFilterItem>
			<ViewSettingsCustomItem
				id="priceFilterItem"
				text="{i18n>priceFilterTitle}"
				key="Price">
				<customControl>
					<l:VerticalLayout
						width="100%"
						class="sapUiContentPadding">
						<RangeSlider
							id="rangeSlider"
							width="100%"
							min="0"
							max="{path: 'view>/MaxPrice', mode: 'OneWay'}"
							value="0"
							value2="{path: 'view>/MaxPrice', mode: 'OneWay'}"
							class="sapUiSmallMarginTop"
							step="10"
							change=".handleChange"/>
					</l:VerticalLayout>
				</customControl>
			</ViewSettingsCustomItem>
		</filterItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>
