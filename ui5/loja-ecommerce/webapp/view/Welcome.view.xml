<mvc:View
	controllerName="lojaecommerce.controller.Welcome"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{CurrencyType: 'sap/ui/model/type/Currency'}">
	<Page
		id="page">
		<landmarkInfo>
			<PageAccessibleLandmarkInfo
				rootRole="Region"
				rootLabel="{i18n>Welcome_rootLabel}"
				contentRole="Main"
				contentLabel="{i18n>Welcome_contentLabel}"
				headerRole="Region"
				headerLabel="{i18n>Welcome_headerLabel}"/>
		</landmarkInfo>
		<customHeader>
			<Bar>
				<contentLeft>
					<Button
						icon="sap-icon://menu2"
						press=".onShowCategories"
						visible="{appView>/smallScreenMode}"/>
				</contentLeft>
				<contentMiddle>
					<Title
						level="H2"
						tooltip="{i18n>welcomeDescription}"
						text="{i18n>welcomeHeadline}"/>
				</contentMiddle>
				<contentRight>
					<Button
						icon="sap-icon://customer"
						text="{path: 'session>/customer', formatter: '.formatter.greeting'}"
						press=".onAvatarPress"
						tooltip="{i18n>avatarButtonTooltip}"/>
					<ToggleButton
						icon="sap-icon://cart"
						pressed="{= ${appView>/layout}.startsWith('ThreeColumns') }"
						tooltip="{i18n>toCartButtonTooltip}"
						press=".onToggleCart">
						<customData>
							<BadgeCustomData
								key="badge"
								value="{path: 'cartProducts>/cartEntries', formatter: '.formatter.cartCount'}"/>
						</customData>
					</ToggleButton>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<l:BlockLayout background="Light">
				<l:BlockLayoutRow>
					<l:BlockLayoutCell class="sapUiNoContentPadding">
						<Carousel
							id="welcomeCarousel"
							showPageIndicator="false"
							loop="true"
							pageChanged=".onCarouselPageChanged"
							visible="{=!${device>/system/phone}}"
							tooltip="{i18n>welcomeDescription}">
							<pages>
								<VBox renderType="Bare" class="welcomeBanner">
									<Title level="H1" titleStyle="H1" text="{i18n>welcomeBanner1Title}"/>
									<Text text="{i18n>welcomeBanner1Text}"/>
								</VBox>
								<VBox renderType="Bare" class="welcomeBanner welcomeBannerAlt1">
									<Title level="H1" titleStyle="H1" text="{i18n>welcomeBanner2Title}"/>
									<Text text="{i18n>welcomeBanner2Text}"/>
								</VBox>
								<VBox renderType="Bare" class="welcomeBanner welcomeBannerAlt2">
									<Title level="H1" titleStyle="H1" text="{i18n>welcomeBanner3Title}"/>
									<Text text="{i18n>welcomeBanner3Text}"/>
								</VBox>
								<VBox renderType="Bare" class="welcomeBanner welcomeBannerAlt3">
									<Title level="H1" titleStyle="H1" text="{i18n>welcomeBanner4Title}"/>
									<Text text="{i18n>welcomeBanner4Text}"/>
								</VBox>
							</pages>
						</Carousel>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
			</l:BlockLayout>
			<Panel
				id="panelPromoted"
				accessibleRole="Region"
				backgroundDesign="Transparent"
				class="sapUiNoContentPadding"
				visible="{= ${/Promoted}.length > 0 }">
				<headerToolbar>
					<Toolbar>
						<Title
							text="{i18n>promotedTitle}"
							level="H3"
							titleStyle="H2"
							class="sapUiMediumMarginTopBottom"/>
					</Toolbar>
				</headerToolbar>
				<l:BlockLayout background="Dashboard">
					<l:BlockLayoutRow
						id="promotedRow"
						content="{/Promoted}">
						<l:content>
							<l:BlockLayoutCell class="sapUiContentPadding">
								<l:Grid
									defaultSpan="XL12 L12 M12 S12"
									vSpacing="0"
									hSpacing="0">
									<FlexBox
										height="3.5rem"
										renderType="Bare">
										<l:VerticalLayout>
											<ObjectIdentifier
												title="{Name}"
												titleActive="true"
												titlePress=".onSelectProduct"
												tooltip="{i18n>openProductDetails} {Name}"
												class="sapUiTinyMarginBottom"/>
											<ObjectStatus
												text="{
													path : 'Status',
													formatter : '.formatter.statusText'
												}"
												state="{
													path : 'Status',
													formatter : '.formatter.statusState'
												}"/>
										</l:VerticalLayout>
									</FlexBox>
									<FlexBox
										renderType="Bare"
										justifyContent="Center">
										<Image
											src="{
												path: 'PictureUrl',
												formatter : '.formatter.pictureUrl'
											}"
											densityAware="false"
											width="50%"
											height="50%"
											class="productPicture"
											press=".onSelectProduct"
											tooltip="{i18n>openProductDetails} {Name}"
											alt="{i18n>alternativeImageText} {Name}"/>
									</FlexBox>
									<Button
										tooltip="{i18n>addToCart}"
										type="Emphasized"
										enabled="{path: 'Status', formatter: '.formatter.isBuyable'}"
										press=".onAddToCart"
										icon="sap-icon://cart-3">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S4"/>
										</layoutData>
									</Button>
									<ObjectListItem
										class="welcomePrice"
										number="{
											parts:[
												{path:'Price'},
												{path:'CurrencyCode'}
											],
											type: 'CurrencyType',
											formatOptions:{showMeasure: false}
										}"
										numberUnit="{CurrencyCode}">
										<layoutData>
											<l:GridData span="XL8 L8 M8 S8"/>
										</layoutData>
									</ObjectListItem>
								</l:Grid>
							</l:BlockLayoutCell>
						</l:content>
					</l:BlockLayoutRow>
				</l:BlockLayout>
			</Panel>
			<Panel
				id="panelLastUnits"
				accessibleRole="Region"
				backgroundDesign="Transparent"
				class="sapUiNoContentPadding"
				visible="{= ${/LastUnits}.length > 0 }">
				<headerToolbar>
					<Toolbar>
						<Title
							text="{i18n>lastUnitsTitle}"
							level="H3"
							titleStyle="H2"
							class="sapUiMediumMarginTopBottom"/>
					</Toolbar>
				</headerToolbar>
				<l:BlockLayout background="Dashboard">
					<l:BlockLayoutRow
						id="lastunitsRow"
						content="{/LastUnits}">
						<l:content>
							<l:BlockLayoutCell class="sapUiContentPadding">
								<l:Grid
									defaultSpan="XL12 L12 M12 S12"
									vSpacing="0"
									hSpacing="0">
									<FlexBox
										height="3.5rem"
										renderType="Bare">
										<l:VerticalLayout>
											<ObjectIdentifier
												title="{Name}"
												titleActive="true"
												titlePress=".onSelectProduct"
												tooltip="{i18n>openProductDetails} {Name}"
												class="sapUiTinyMarginBottom"/>
											<ObjectStatus
												text="{
													path : 'Status',
													formatter : '.formatter.statusText'
												}"
												state="{
													path : 'Status',
													formatter : '.formatter.statusState'
												}"/>
										</l:VerticalLayout>
									</FlexBox>
									<FlexBox
										renderType="Bare"
										justifyContent="Center">
										<Image
											src="{
												path: 'PictureUrl',
												formatter : '.formatter.pictureUrl'
											}"
											densityAware="false"
											width="50%"
											height="50%"
											class="productPicture"
											press=".onSelectProduct"
											tooltip="{i18n>openProductDetails} {Name}"
											alt="{i18n>alternativeImageText} {Name}"/>
									</FlexBox>
									<Button
										tooltip="{i18n>addToCart}"
										type="Emphasized"
										enabled="{path: 'Status', formatter: '.formatter.isBuyable'}"
										press=".onAddToCart"
										icon="sap-icon://cart-3">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S4"/>
										</layoutData>
									</Button>
									<ObjectListItem
										class="welcomePrice"
										number="{
											parts:[
												{path:'Price'},
												{path:'CurrencyCode'}
											],
											type: 'CurrencyType',
											formatOptions:{showMeasure: false}
										}"
										numberUnit="{CurrencyCode}">
										<layoutData>
											<l:GridData span="XL8 L8 M8 S8"/>
										</layoutData>
									</ObjectListItem>
								</l:Grid>
							</l:BlockLayoutCell>
						</l:content>
					</l:BlockLayoutRow>
				</l:BlockLayout>
			</Panel>
			<Panel
				id="panelNewest"
				accessibleRole="Region"
				backgroundDesign="Transparent"
				class="sapUiNoContentPadding"
				visible="{= ${/Newest}.length > 0 }">
				<headerToolbar>
					<Toolbar>
						<Title
							text="{i18n>newestTitle}"
							level="H3"
							titleStyle="H2"
							class="sapUiMediumMarginTopBottom"/>
					</Toolbar>
				</headerToolbar>
				<l:BlockLayout background="Dashboard">
					<l:BlockLayoutRow
						id="newestRow"
						content="{/Newest}">
						<l:content>
							<l:BlockLayoutCell class="sapUiContentPadding">
								<l:Grid
									defaultSpan="XL12 L12 M12 S12"
									vSpacing="0"
									hSpacing="0">
									<FlexBox
										height="3.5rem"
										renderType="Bare">
										<l:VerticalLayout>
											<ObjectIdentifier
												title="{Name}"
												titleActive="true"
												titlePress=".onSelectProduct"
												tooltip="{i18n>openProductDetails} {Name}"
												class="sapUiTinyMarginBottom"/>
											<ObjectStatus
												text="{
													path : 'Status',
													formatter : '.formatter.statusText'
												}"
												state="{
													path : 'Status',
													formatter : '.formatter.statusState'
												}"/>
										</l:VerticalLayout>
									</FlexBox>
									<FlexBox
										renderType="Bare"
										justifyContent="Center">
										<Image
											src="{
												path: 'PictureUrl',
												formatter : '.formatter.pictureUrl'
											}"
											densityAware="false"
											width="50%"
											height="50%"
											class="productPicture"
											press=".onSelectProduct"
											tooltip="{i18n>openProductDetails} {Name}"
											alt="{i18n>alternativeImageText} {Name}"/>
									</FlexBox>
									<Button
										tooltip="{i18n>addToCart}"
										type="Emphasized"
										enabled="{path: 'Status', formatter: '.formatter.isBuyable'}"
										press=".onAddToCart"
										icon="sap-icon://cart-3">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S4"/>
										</layoutData>
									</Button>
									<ObjectListItem
										class="welcomePrice"
										number="{
											parts:[
												{path:'Price'},
												{path:'CurrencyCode'}
											],
											type: 'CurrencyType',
											formatOptions:{showMeasure: false}
										}"
										numberUnit="{CurrencyCode}">
										<layoutData>
											<l:GridData span="XL8 L8 M8 S8"/>
										</layoutData>
									</ObjectListItem>
								</l:Grid>
							</l:BlockLayoutCell>
						</l:content>
					</l:BlockLayoutRow>
				</l:BlockLayout>
			</Panel>
		</content>
	</Page>
</mvc:View>
