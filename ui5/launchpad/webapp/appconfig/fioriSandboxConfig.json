{
  "defaultRenderer": "fiori2",
  "renderers": {
    "fiori2": {
      "componentData": {
        "config": {
          "enableSearch": false,
          "rootIntent": "Shell-home"
        }
      }
    }
  },
  "services": {
    "LaunchPage": {
      "adapter": {
        "config": {
          "groups": [
            {
              "id": "gestao",
              "title": "Gestão",
              "isPreset": true,
              "isVisible": true,
              "isDefaultGroup": true,
              "isGroupLocked": false,
              "tiles": [
                {
                  "id": "tile-gestaoclientes",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Gestão de Clientes",
                    "subtitle": "Clientes e endereços",
                    "icon": "sap-icon://customer",
                    "targetURL": "#ZPCCliente-manage"
                  }
                },
                {
                  "id": "tile-gestaoestoque",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Gestão de Estoque",
                    "subtitle": "Itens, SKU e disponibilidade",
                    "icon": "sap-icon://product",
                    "targetURL": "#ZPCItemEstoque-manage"
                  }
                },
                {
                  "id": "tile-pedidoscompras",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Pedidos de Compras",
                    "subtitle": "Criar, pagar, aprovar e cancelar",
                    "icon": "sap-icon://sales-order",
                    "targetURL": "#ZPCPedidoCompra-manage"
                  }
                },
                {
                  "id": "tile-gestaoreembolsos",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Gestão de Reembolsos",
                    "subtitle": "Aprovar ou rejeitar reembolsos",
                    "icon": "sap-icon://expense-report",
                    "targetURL": "#ZPCReembolso-manage"
                  }
                }
              ]
            },
            {
              "id": "analises",
              "title": "Análises",
              "isPreset": true,
              "isVisible": true,
              "isDefaultGroup": false,
              "isGroupLocked": false,
              "tiles": [
                {
                  "id": "tile-analisepedidos",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Análise de Pedidos de Compras",
                    "subtitle": "Valores, status e pagamentos",
                    "icon": "sap-icon://sales-order-item",
                    "targetURL": "#ZPCAnalisePedido-display"
                  }
                },
                {
                  "id": "tile-analiseclientes",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Análise de Clientes",
                    "subtitle": "Gênero, UF, cadastros e score",
                    "icon": "sap-icon://customer-view",
                    "targetURL": "#ZPCAnaliseCliente-display"
                  }
                },
                {
                  "id": "tile-analiseestoque",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Análise de Itens do Estoque",
                    "subtitle": "Categorias, reservas e valor em estoque",
                    "icon": "sap-icon://inventory",
                    "targetURL": "#ZPCAnaliseItemEstoque-display"
                  }
                },
                {
                  "id": "tile-analisereembolsos",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Análise de Pedidos de Reembolsos",
                    "subtitle": "Valores, status e motivos",
                    "icon": "sap-icon://money-bills",
                    "targetURL": "#ZPCAnaliseReembolso-display"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "NavTargetResolution": {
      "adapter": {
        "config": {
          "applications": {
            "ZPCCliente-manage": {
              "additionalInformation": "SAPUI5.Component=gestaoclientes",
              "applicationType": "URL",
              "url": "/apps/gestaoclientes",
              "title": "Gestão de Clientes",
              "description": "Clientes e endereços"
            },
            "ZPCItemEstoque-manage": {
              "additionalInformation": "SAPUI5.Component=gestaoestoque",
              "applicationType": "URL",
              "url": "/apps/gestaoestoque",
              "title": "Gestão de Estoque",
              "description": "Itens, SKU e disponibilidade"
            },
            "ZPCPedidoCompra-manage": {
              "additionalInformation": "SAPUI5.Component=pedidoscompras",
              "applicationType": "URL",
              "url": "/apps/pedidoscompras",
              "title": "Pedidos de Compras",
              "description": "Criar, pagar, aprovar e cancelar"
            },
            "ZPCReembolso-manage": {
              "additionalInformation": "SAPUI5.Component=gestaoreembolsos",
              "applicationType": "URL",
              "url": "/apps/gestaoreembolsos",
              "title": "Gestão de Reembolsos",
              "description": "Aprovar ou rejeitar reembolsos"
            },
            "ZPCAnalisePedido-display": {
              "additionalInformation": "SAPUI5.Component=analisepedidos",
              "applicationType": "URL",
              "url": "/apps/analisepedidos",
              "title": "Análise de Pedidos de Compras",
              "description": "Valores, status e pagamentos"
            },
            "ZPCAnaliseCliente-display": {
              "additionalInformation": "SAPUI5.Component=analiseclientes",
              "applicationType": "URL",
              "url": "/apps/analiseclientes",
              "title": "Análise de Clientes",
              "description": "Gênero, UF, cadastros e score"
            },
            "ZPCAnaliseItemEstoque-display": {
              "additionalInformation": "SAPUI5.Component=analiseestoque",
              "applicationType": "URL",
              "url": "/apps/analiseestoque",
              "title": "Análise de Itens do Estoque",
              "description": "Categorias, reservas e valor em estoque"
            },
            "ZPCAnaliseReembolso-display": {
              "additionalInformation": "SAPUI5.Component=analisereembolsos",
              "applicationType": "URL",
              "url": "/apps/analisereembolsos",
              "title": "Análise de Pedidos de Reembolsos",
              "description": "Valores, status e motivos"
            }
          }
        }
      }
    }
  }
}
