<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Communication.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Communication.v1" Alias="Communication"/>
    </edmx:Reference>
    <edmx:Reference Uri="/sap/opu/odata4/sap/zui_pc_analitico_o4/srvd/sap/zui_pc_analitico/0001/$metadata">
        <edmx:Include Namespace="com.sap.gateway.srvd.zui_pc_analitico.v0001" Alias="SAP__self"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">

            <!-- ============================ Pedidos ============================ -->
            <Annotations Target="SAP__self.PedidoAnaliseType">
                <!-- Navegação dos cards (UI.Identification é obrigatória em cards OVP) -->
                <Annotation Term="UI.Identification">
                    <Collection>
                        <Record Type="UI.DataFieldForIntentBasedNavigation">
                            <PropertyValue Property="SemanticObject" String="ZPCPedidoCompra"/>
                            <PropertyValue Property="Action" String="manage"/>
                            <PropertyValue Property="Label" String="Abrir Pedidos de Compras"/>
                        </Record>
                    </Collection>
                </Annotation>
                <!-- Pedidos pagos que aguardam aprovação -->
                <Annotation Term="UI.SelectionVariant" Qualifier="AguardandoAprovacao">
                    <Record Type="UI.SelectionVariantType">
                        <PropertyValue Property="Text" String="Aguardando aprovação"/>
                        <PropertyValue Property="SelectOptions">
                            <Collection>
                                <Record Type="UI.SelectOptionType">
                                    <PropertyValue Property="PropertyName" PropertyPath="StatusPedido"/>
                                    <PropertyValue Property="Ranges">
                                        <Collection>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="AGUARDANDO_APROVACAO"/>
                                            </Record>
                                        </Collection>
                                    </PropertyValue>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

            <!-- ============================ Clientes ============================ -->
            <Annotations Target="SAP__self.ClienteAnaliseType">
                <Annotation Term="UI.Identification">
                    <Collection>
                        <Record Type="UI.DataFieldForIntentBasedNavigation">
                            <PropertyValue Property="SemanticObject" String="ZPCCliente"/>
                            <PropertyValue Property="Action" String="manage"/>
                            <PropertyValue Property="Label" String="Abrir Gestão de Clientes"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>

            <!-- ============================ Estoque ============================= -->
            <Annotations Target="SAP__self.ItemAnaliseType">
                <Annotation Term="UI.Identification">
                    <Collection>
                        <Record Type="UI.DataFieldForIntentBasedNavigation">
                            <PropertyValue Property="SemanticObject" String="ZPCItemEstoque"/>
                            <PropertyValue Property="Action" String="manage"/>
                            <PropertyValue Property="Label" String="Abrir Gestão de Estoque"/>
                        </Record>
                    </Collection>
                </Annotation>
                <!-- A OVP não tem gráfico de barras horizontais: mesma visão em colunas -->
                <Annotation Term="UI.Chart" Qualifier="EstoquePorCategoriaOVP">
                    <Record Type="UI.ChartDefinitionType">
                        <PropertyValue Property="Title" String="Estoque por categoria"/>
                        <PropertyValue Property="ChartType" EnumMember="UI.ChartType/Column"/>
                        <PropertyValue Property="Dimensions">
                            <Collection>
                                <PropertyPath>Categoria</PropertyPath>
                            </Collection>
                        </PropertyValue>
                        <PropertyValue Property="DimensionAttributes">
                            <Collection>
                                <Record Type="UI.ChartDimensionAttributeType">
                                    <PropertyValue Property="Dimension" PropertyPath="Categoria"/>
                                    <PropertyValue Property="Role" EnumMember="UI.ChartDimensionRoleType/Category"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                        <PropertyValue Property="Measures">
                            <Collection>
                                <PropertyPath>QtdeDisponivel</PropertyPath>
                                <PropertyPath>QtdeReservada</PropertyPath>
                            </Collection>
                        </PropertyValue>
                        <PropertyValue Property="MeasureAttributes">
                            <Collection>
                                <Record Type="UI.ChartMeasureAttributeType">
                                    <PropertyValue Property="Measure" PropertyPath="QtdeDisponivel"/>
                                    <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                                </Record>
                                <Record Type="UI.ChartMeasureAttributeType">
                                    <PropertyValue Property="Measure" PropertyPath="QtdeReservada"/>
                                    <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <!-- Itens sem estoque ou acabando -->
                <Annotation Term="UI.SelectionVariant" Qualifier="EstoqueCritico">
                    <Record Type="UI.SelectionVariantType">
                        <PropertyValue Property="Text" String="Sem estoque ou acabando"/>
                        <PropertyValue Property="SelectOptions">
                            <Collection>
                                <Record Type="UI.SelectOptionType">
                                    <PropertyValue Property="PropertyName" PropertyPath="StatusEstoque"/>
                                    <PropertyValue Property="Ranges">
                                        <Collection>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="SEM_ESTOQUE"/>
                                            </Record>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="ACABANDO"/>
                                            </Record>
                                        </Collection>
                                    </PropertyValue>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

            <!-- =========================== Reembolsos =========================== -->
            <Annotations Target="SAP__self.ReembolsoAnaliseType">
                <Annotation Term="UI.Identification">
                    <Collection>
                        <Record Type="UI.DataFieldForIntentBasedNavigation">
                            <PropertyValue Property="SemanticObject" String="ZPCReembolso"/>
                            <PropertyValue Property="Action" String="manage"/>
                            <PropertyValue Property="Label" String="Abrir Gestão de Reembolsos"/>
                        </Record>
                    </Collection>
                </Annotation>
                <!-- Solicitações aguardando decisão -->
                <Annotation Term="UI.SelectionVariant" Qualifier="Pendentes">
                    <Record Type="UI.SelectionVariantType">
                        <PropertyValue Property="Text" String="Pendentes"/>
                        <PropertyValue Property="SelectOptions">
                            <Collection>
                                <Record Type="UI.SelectOptionType">
                                    <PropertyValue Property="PropertyName" PropertyPath="StatusReembolso"/>
                                    <PropertyValue Property="Ranges">
                                        <Collection>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="PENDENTE"/>
                                            </Record>
                                        </Collection>
                                    </PropertyValue>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
