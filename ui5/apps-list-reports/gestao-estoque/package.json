{
  "name": "gestao-estoque",
  "version": "0.0.1",
  "description": "Cadastro de itens, preço, quantidades em estoque e reservas",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^4.0.33",
    "@sap/ux-ui5-tooling": "1",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "eslint": "^10",
    "@sap-ux/ui5-middleware-fe-mockserver": "2"
  },
  "scripts": {
    "start": "node ../../scripts/sap-env.mjs fiori run --open \"test/flp.html#app-preview\"",
    "start-local": "node ../../scripts/sap-env.mjs fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint ./",
    "start-mock": "node ../../scripts/sap-env.mjs fiori run --config ./ui5-mock.yaml --open \"test/flp.html#app-preview\"",
    "deploy": "npm run build && node ../../scripts/sap-env.mjs fiori deploy --config ui5-deploy.yaml",
    "start-noflp": "node ../../scripts/sap-env.mjs fiori run --open \"/index.html?sap-ui-xx-viewCache=false\"",
    "int-test": "node ../../scripts/sap-env.mjs fiori run --config ./ui5-mock.yaml --open \"/test/integration/opaTests.qunit.html\"",
    "start-variants-management": "node ../../scripts/sap-env.mjs fiori run --open \"/preview.html#app-preview\"",
    "deploy-test": "npm run build && node ../../scripts/sap-env.mjs fiori deploy --config ui5-deploy.yaml --testMode true",
    "undeploy": "node ../../scripts/sap-env.mjs fiori undeploy --config ui5-deploy.yaml"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "sapux": true
}
