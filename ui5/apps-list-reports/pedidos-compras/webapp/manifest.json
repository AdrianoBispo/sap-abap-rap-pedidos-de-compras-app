{
  "_version": "2.0.0",
  "sap.app": {
    "id": "pedidoscompras",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.28.0",
      "toolsId": "6ead1d52-52db-44f2-b9dd-d708aa94b2d7"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_pc_pedidos_compras_o4/srvd/sap/zui_pc_pedidos_compras/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZPCPedidoCompra-manage": {
          "semanticObject": "ZPCPedidoCompra",
          "action": "manage",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "icon": "sap-icon://sales-order",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://sales-order",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.7",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "pedidoscompras.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "pedidoscompras.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PedidoList",
          "target": "PedidoList"
        },
        {
          "pattern": "Pedido({key}):?query:",
          "name": "PedidoObjectPage",
          "target": "PedidoObjectPage"
        },
        {
          "name": "Pedido__ItensObjectPage",
          "pattern": "Pedido({key})/_Itens({_ItensKey}):?query:",
          "target": "Pedido__ItensObjectPage"
        },
        {
          "name": "Pedido__ItensSnapshotObjectPage",
          "pattern": "Pedido({key})/_ItensSnapshot({_ItensSnapshotKey}):?query:",
          "target": "Pedido__ItensSnapshotObjectPage"
        }
      ],
      "targets": {
        "PedidoList": {
          "type": "Component",
          "id": "PedidoList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Pedido",
              "variantManagement": "Page",
              "navigation": {
                "Pedido": {
                  "detail": {
                    "route": "PedidoObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "PedidoObjectPage": {
          "type": "Component",
          "id": "PedidoObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Pedido",
              "navigation": {
                "_Itens": {
                  "detail": {
                    "route": "Pedido__ItensObjectPage"
                  }
                },
                "_ItensSnapshot": {
                  "detail": {
                    "route": "Pedido__ItensSnapshotObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_Itens/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "creationMode": {
                      "name": "Inline",
                      "createAtEnd": true
                    }
                  }
                }
              }
            }
          }
        },
        "Pedido__ItensObjectPage": {
          "type": "Component",
          "id": "Pedido__ItensObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Pedido/_Itens"
            }
          }
        },
        "Pedido__ItensSnapshotObjectPage": {
          "type": "Component",
          "id": "Pedido__ItensSnapshotObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Pedido/_ItensSnapshot"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
