-viacep" name="4 · Endereço e ViaCEP"><mxGraphModel adaptiveColors="auto" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Fluxo do endereço do cliente — consulta de CEP no ViaCEP e validações" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1D2D3E;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="6" width="2070" height="34" as="geometry" /></mxCell><mxCell id="v2" value="Toda a consulta é feita no backend; o CEP é um campo padrão do Fiori Elements (sem extensão SAPUI5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#475E75;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="2070" height="26" as="geometry" /></mxCell><mxCell id="v3" value="" style="rounded=0;html=1;strokeColor=#D5DADD;strokeWidth=1;fillColor=#EBF8FF;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2070" height="150" as="geometry" /></mxCell><mxCell id="v4" value="" style="rounded=0;html=1;strokeColor=#D5DADD;fillColor=#EBF8FF;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="160" height="150" as="geometry" /></mxCell><mxCell id="v5" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#0070F2;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="5" height="150" as="geometry" /></mxCell><mxCell id="v6" value="" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;html=1;whiteSpace=wrap;fontColor=#1D2D3E;fontSize=12;SAPIcon=User" vertex="1" parent="1"><mxGeometry x="60" y="88" width="40" height="40" as="geometry" /></mxCell><mxCell id="v7" value="Usuário · app Gestão de Clientes" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1D2D3E;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><